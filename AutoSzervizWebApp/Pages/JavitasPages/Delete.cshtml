@page
@model AutoSzervizWebApp.Pages.JavitasPages.DeleteModel

@{
    ViewData["Title"] = "Javítás törlése";
}

<h3>Biztosan törölni szeretné ezt a javítást?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Ügyfél neve
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Javitas.Ugyfel.Nev)
        </dd>
        <dt class = "col-sm-2">
            Rendszám
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Javitas.Rendszam)
        </dd>
        <dt class = "col-sm-2">
            Leírás
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Javitas.Leiras)
        </dd>
        <dt class = "col-sm-2">
            Költség
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Javitas.Koltseg)
        </dd>
        <dt class = "col-sm-2">
            Állapot
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Javitas.Allapot)
        </dd>
        <dt class = "col-sm-2">
            Felvétel dátuma
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Javitas.FelvetelDatuma)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Javitas.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger px-4 py-2 rounded-3 shadow-sm fw-semibold" /> |
        <a asp-page="./Index" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Vissza a listára</a>
    </form>
</div>
