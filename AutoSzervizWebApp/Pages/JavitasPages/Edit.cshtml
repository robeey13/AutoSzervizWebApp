@page
@model AutoSzervizWebApp.Pages.JavitasPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Javitas</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Javitas.Id" />
            <div class="form-group">
                <label asp-for="Javitas.UgyfelId">Ügyfél</label>
                <select asp-for="Javitas.UgyfelId"
                        asp-items="Model.UgyfelekSelectList"
                        class="form-select">
                    <option value="">-- Válassz ügyfelet --</option>
                </select>
                <span asp-validation-for="Javitas.UgyfelId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Javitas.Rendszam" class="control-label"></label>
                <input asp-for="Javitas.Rendszam" class="form-control" aria-required="true"/>
                <span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Leiras" class="control-label"></label>
                <input asp-for="Javitas.Leiras" class="form-control" />
                <span asp-validation-for="Javitas.Leiras" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Koltseg" class="control-label"></label>
                <input asp-for="Javitas.Koltseg" class="form-control" />
                <span asp-validation-for="Javitas.Koltseg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
