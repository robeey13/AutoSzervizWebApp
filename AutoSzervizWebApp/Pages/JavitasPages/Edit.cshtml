@page
@model AutoSzervizWebApp.Pages.JavitasPages.EditModel

@{
    ViewData["Title"] = "Javitás szerkesztése";
}

<h4>Javítás szerkesztése</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Javitas.Id" />
            <div class="form-group">
                <label asp-for="Javitas.UgyfelId" class="form-label fw-semibold text-dark">Ügyfél</label>
                <select asp-for="Javitas.UgyfelId"
                        asp-items="Model.UgyfelekSelectList"
                        class="form-select form-select-lg rounded-3 shadow-sm">
                    <option value="">-- Válassz ügyfelet --</option>
                </select>
                <span asp-validation-for="Javitas.UgyfelId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Javitas.Rendszam" class="form-label fw-semibold text-dark">Rendszám</label>
                <input asp-for="Javitas.Rendszam" class="form-control form-control-lg rounded-3 shadow-sm" aria-required="true" />
                <span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Leiras" class="form-label fw-semibold text-dark">Leírás</label>
                <input asp-for="Javitas.Leiras" class="form-control form-control-lg rounded-3 shadow-sm" />
                <span asp-validation-for="Javitas.Leiras" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Koltseg" class="form-label fw-semibold text-dark">Költség</label>
                <input asp-for="Javitas.Koltseg" class="form-control form-control-lg rounded-3 shadow-sm" />
                <span asp-validation-for="Javitas.Koltseg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold" /> |
                <a asp-page="./Index" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Vissza a listára</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
