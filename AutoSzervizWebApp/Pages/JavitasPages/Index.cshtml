@page
@model AutoSzervizWebApp.Pages.JavitasPages.IndexModel
@using AutoSzervizWebApp.Enums

@{
    ViewData["Title"] = "Javítások";
}

<p>
    <a asp-page="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Új javitas</a>
</p>

<table class="table">
    <thead>
        @if (!string.IsNullOrEmpty(Model.Hiba))
        {
            <div class="alert alert-warning">@Model.Hiba</div>
        }


        <form method="get" class="mb-3">
            <label asp-for="AllapotSzuro" class="form-label fw-semibold text-dark">Szűrés állapot szerint</label>
            <select asp-for="AllapotSzuro"
                    asp-items="Html.GetEnumSelectList<JavitasAllapot>()"
                    class="form-select form-select-lg rounded-3 shadow-sm">
            </select>
            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Szűrés</button> | 
            <a asp-page="./Index" class="btn btn-secondary px-4 py-2 rounded-3 shadow-sm fw-semibold">Szűrés törlése</a>
        </form>
        <tr>
            <th>
                Ügyfél neve
            </th>
            <th>
                Rendszáma
            </th>
            <th>
                Leírás
            </th>
            <th>
                Költség
            </th>
            <th>
                Állapot
            </th>
            <th>
                Állapot váltása
            </th>
            <th>
                Felvétel dátuma
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Javitas) {
        <tr>
            <td>
                    @item.Ugyfel?.Nev
            </td>
            <td>
                    @item.Rendszam
            </td>
            <td>
                    @item.Leiras
            </td>
            <td>
                    @item.Koltseg
            </td>
            <td>
                    @if (item.Allapot == JavitasAllapot.Felveve)
                    {
                        <span class="text-danger fw-semibold">Felvéve</span>
                    }
                    else if (item.Allapot == JavitasAllapot.Folyamatban)
                    {
                        <span class="text-warning fw-semibold">Folyamatban</span>
                    }
                    else if (item.Allapot == JavitasAllapot.Kesz)
                    {
                        <span class="text-success fw-semibold">Kész</span>
                    }
            </td>
            <td>
                    @if (item.Allapot != JavitasAllapot.Kesz)
                    {
                        <form method="post"
                              asp-page-handler="Allapot">
                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-success px-4 py-2 rounded-3 shadow-sm fw-semibold">
                                Következő állapot
                            </button>
                        </form>
                    }
                </td>
            <td>
                    @item.FelvetelDatuma.ToString("yyyy-MM-dd")
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Szerkesztés</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger px-4 py-2 rounded-3 shadow-sm fw-semibold">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
