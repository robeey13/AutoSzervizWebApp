@page
@model AutoSzervizWebApp.Pages.UgyfelPages.DeleteModel

@{
    ViewData["Title"] = "Ügyfél törlése";
}

<h3>Biztosan szeretné törölni az ügyfelet?</h3>
<div>
    <h4>@Html.DisplayFor(model => model.Ugyfel.Nev)</h4>
    <div asp-validation-summary="All" class="text-danger"></div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Telefonszám
        </dt>
        <dd class = "col-sm-10">
            @(Model.Ugyfel.Telefon ?? "Nincs megadva")
        </dd>
        <dt class = "col-sm-2">
            Email cime
        </dt>
        <dd class = "col-sm-10">
            @(Model.Ugyfel.Email ?? "Nincs megadva")
        </dd>
        <dt class = "col-sm-2">
            Javitásainak száma
        </dt>
        <dd class = "col-sm-10">
            @Model.Ugyfel.Javitasok.Count()
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Ugyfel.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger px-4 py-2 rounded-3 shadow-sm fw-semibold" /> |
        <a asp-page="./Index" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Vissza a listához</a>
    </form>
</div>
