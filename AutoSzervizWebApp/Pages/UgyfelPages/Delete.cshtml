@page
@model AutoSzervizWebApp.Pages.UgyfelPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Ügyfél törlése</h1>

<h3>Biztosan szeretné törölni?</h3>
<div>
    <h4>@Html.DisplayFor(model => model.Ugyfel.Nev)</h4>
    <div asp-validation-summary="All" class="text-danger"></div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Telefon)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Telefon)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Javitasok)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Javitasok)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Ugyfel.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-page="./Index">Vissza a listához</a>
    </form>
</div>
