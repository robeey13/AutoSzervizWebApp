@page
@model AutoSzervizWebApp.Pages.UgyfelPages.DetailsModel

@{
    ViewData["Title"] = "Ügyfél részletei";
}

<h1>Javítások: @Model.Ugyfel.Nev</h1>

<div class="row">
    <div class="col-md-4">
        <dl class="row">
            <dt class="col-sm-3">Név</dt>
            <dd class="col-sm-9">@Model.Ugyfel.Nev</dd>
            <dt class="col-sm-3">Telefonszám</dt>
            <dd class="col-sm-9">@(Model.Ugyfel.Telefon ?? "Nincs megadva")</dd>
            <dt class="col-sm-3">Email cím</dt>
            <dd class="col-sm-9">@(Model.Ugyfel.Email ?? "Nincs megadva")</dd>
        </dl>
    </div>
</div>

<div>

    @if (!Model.Ugyfel.Javitasok.Any())
    {
        <p>Ehhez az ügyfélhez még nincs javítás rögzítve.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Rendszám</th>
                    <th>Leírás</th>
                    <th>Költség</th>
                    <th>Állapot</th>
                    <th>Felvétel dátuma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var javitas in Model.Ugyfel.Javitasok
                    .OrderByDescending(j => j.FelvetelDatuma))
                {
                    <tr>
                        <td>@javitas.Rendszam</td>
                        <td>@javitas.Leiras</td>
                        <td>
                            @(javitas.Koltseg.HasValue
                                ? $"{javitas.Koltseg.Value:N2} Ft"
                                : "Nincs megadva")
                        </td>
                        <td>@javitas.Allapot</td>
                        <td>@javitas.FelvetelDatuma.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>Összköltség: @Model.Osszkoltseg.ToString("N2") Ft</h3>
</div>
<div>
    <a asp-page="./Index" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Vissza a listához</a>
</div>
