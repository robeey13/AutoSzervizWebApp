@page
@model AutoSzervizWebApp.Pages.UgyfelPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Javítások: @Model.Ugyfel.Nev</h1>

<div>

    @if (!Model.Ugyfel.Javitasok.Any())
    {
        <p>Ehhez az ügyfélhez még nincs javítás rögzítve.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Rendszám</th>
                    <th>Leírás</th>
                    <th>Költség</th>
                    <th>Állapot</th>
                    <th>Felvétel dátuma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var javitas in Model.Ugyfel.Javitasok
                    .OrderByDescending(j => j.FelvetelDatuma))
                {
                    <tr>
                        <td>@javitas.Rendszam</td>
                        <td>@javitas.Leiras</td>
                        <td>
                            @(javitas.Koltseg.HasValue
                                ? $"{javitas.Koltseg.Value:N2} Ft"
                                : "Nincs megadva")
                        </td>
                        <td>@javitas.Allapot</td>
                        <td>@javitas.FelvetelDatuma.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>Összköltség: @Model.Osszkoltseg.ToString("N2") Ft</h3>
</div>
<div>
    <a asp-page="./Index">Back to List</a>
</div>
