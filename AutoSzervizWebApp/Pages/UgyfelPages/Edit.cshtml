@page
@model AutoSzervizWebApp.Pages.UgyfelPages.EditModel

@{
    ViewData["Title"] = "Ügyfél szerkesztése";
}

<h1>Szerkesztés:</h1>

<h4>@Model.Ugyfel.Nev</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Ugyfel.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ugyfel.Nev" class="form-label fw-semibold text-dark">Név</label>
                <input asp-for="Ugyfel.Nev" class="form-control form-control-lg rounded-3 shadow-sm" aria-required="true" />
                <span asp-validation-for="Ugyfel.Nev" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ugyfel.Telefon" class="form-label fw-semibold text-dark">Telefonszám</label>
                <input asp-for="Ugyfel.Telefon" class="form-control form-control-lg rounded-3 shadow-sm" />
                <span asp-validation-for="Ugyfel.Telefon" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ugyfel.Email" class="form-label fw-semibold text-dark">Email cím</label>
                <input asp-for="Ugyfel.Email" class="form-control form-control-lg rounded-3 shadow-sm" />
                <span asp-validation-for="Ugyfel.Email" class="text-danger"></span>
            </div>
            <div class="form-group gap-2">
                <input type="submit" value="Mentés" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold" /> -
                <a asp-page="./Index" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Vissza a listához</a>
            </div>
        </form>
    </div>
</div>

<div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
