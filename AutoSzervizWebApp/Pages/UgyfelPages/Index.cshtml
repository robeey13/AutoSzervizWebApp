@page
@model AutoSzervizWebApp.Pages.UgyfelPages.IndexModel

@{
    ViewData["Title"] = "Ügyfelek főoldala";
}
<p>
    <a asp-page="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold">Új ügyfél felvétele</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Ügyfél neve
            </th>
            <th>
                Telefonszáma
            </th>
            <th>
                Email címe
            </th>
            <th>
                Javítások száma
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Ugyfel) {
        <tr>
            <td>
                @item.Nev
            </td>
            <td>
                    @(Model.Ugyfel.FirstOrDefault(u => u.Id == item.Id)?.Telefon ?? "Nincs megadva")
            </td>
            <td>
                    @(Model.Ugyfel.FirstOrDefault(u => u.Id == item.Id)?.Email ?? "Nincs megadva")
            </td>
            <td>
                    @item.Javitasok.Count()
            </td>
            <td>
                    <a asp-page="./Edit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold" asp-route-id="@item.Id">Adatok szerkesztése</a> 
                <a asp-page="./Details" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-semibold" asp-route-id="@item.Id">Részletek</a> 
                <a asp-page="./Delete" class="btn btn-danger px-4 py-2 rounded-3 shadow-sm fw-semibold" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
